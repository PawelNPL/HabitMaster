<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HabitMaster.Models"
             xmlns:viewmodels="clr-namespace:HabitMaster.ViewModels"
             x:DataType="viewmodels:HabitsViewModel"
             x:Class="HabitMaster.Views.HabitsPage"
             x:Name="PageRoot"
             Title="Nawyki">

    <VerticalStackLayout Padding="16" Spacing="16">

        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" 
                       Text="{Binding SelectedIcon}" 
                       WidthRequest="50" 
                       HorizontalTextAlignment="Center" 
                       MaxLength="2" 
                       FontSize="20" />

                <Entry Grid.Column="1" 
                       Placeholder="Wpisz nowy nawyk..."
                       Text="{Binding NewHabitName}" />

                <Button Grid.Column="2" 
                        Text="Dodaj" 
                        Command="{Binding AddHabitCommand}" 
                        BackgroundColor="{Binding SelectedColorHex}" />
            </Grid>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button WidthRequest="36" HeightRequest="36" CornerRadius="18" BackgroundColor="#FF5049" 
                        Command="{Binding SelectColorCommand}" CommandParameter="#FF5049" />
                <Button WidthRequest="36" HeightRequest="36" CornerRadius="18" BackgroundColor="#4CAF50" 
                        Command="{Binding SelectColorCommand}" CommandParameter="#4CAF50" />
                <Button WidthRequest="36" HeightRequest="36" CornerRadius="18" BackgroundColor="#2196F3" 
                        Command="{Binding SelectColorCommand}" CommandParameter="#2196F3" />
                <Button WidthRequest="36" HeightRequest="36" CornerRadius="18" BackgroundColor="#FFC107" 
                        Command="{Binding SelectColorCommand}" CommandParameter="#FFC107" />
                <Button WidthRequest="36" HeightRequest="36" CornerRadius="18" BackgroundColor="#9C27B0" 
                        Command="{Binding SelectColorCommand}" CommandParameter="#9C27B0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

        <CollectionView ItemsSource="{Binding Habits}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Habit">
                    <Frame CornerRadius="8" Padding="12" Margin="0,4" HasShadow="True" BorderColor="LightGray">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToDetailsCommand}" 
                                CommandParameter="{Binding .}"                             
                                />

                        </Frame.GestureRecognizers>
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsCompletedToday}" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="BackgroundColor" Value="#F8F9FA" />
                            </DataTrigger>
                        </Frame.Triggers>

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" RowDefinitions="Auto">

                            <Frame Grid.Column="0" BackgroundColor="{Binding ColorHex}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" HasShadow="False" VerticalOptions="Center">
                                <Label Text="{Binding Icon}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompletedToday}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding CurrentStreak, StringFormat='Streak: {0} dni'}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="✓"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CompleteHabitCommand}"
                                    CommandParameter="{Binding .}" 
                                    WidthRequest="45" HeightRequest="45" CornerRadius="22" BackgroundColor="#4CAF50">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsCompletedToday}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="BackgroundColor" Value="LightGray" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="3" Text="🗑"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteHabitCommand}"
                                    CommandParameter="{Binding .}" 
                                    WidthRequest="45" HeightRequest="45" CornerRadius="22" BackgroundColor="#F44336" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>